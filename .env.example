# Copy this file to `.env` (same folder as compose.yaml) before running Docker.
# Compose reads `.env` automatically and substitutes ${VARS} into compose.yaml.
# `.env` is gitignored; this example file is committed.

# SQL Server 'sa' password. Must be 8+ chars with upper, lower, digit and symbol
# or the container refuses to start.
MSSQL_SA_PASSWORD=Your_Str0ng!Passw0rd

# Salt used to hash visitor IPs before storing them.
VISITOR_HASH_SALT=change-me-in-production

# Host ports. Change these if something else already uses them.
API_PORT=5219
FRONTEND_PORT=5173
SQLSERVER_PORT=1433
SEQ_PORT=5341
